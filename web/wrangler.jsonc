{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strokeline",
  "main": "./src/cloudflare-worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/hf/*"]
  }
}
