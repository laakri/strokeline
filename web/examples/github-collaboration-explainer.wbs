SCENE 5 "Built Together"

  # ---- beat 1: strangers help, open source ----
  SAY "Open projects let strangers suggest fixes, so great software gets built together."
    DURATION 5.1s
    TONE explain

  CREATE centerPr AS ICON
    POSITION 960 440
    SIZE 200
    NAME git-pull-request
    COLOR #FFD966
  END

  PARALLEL
    CREATE p1 AS ICON
      POSITION 460 160
      SIZE 100
      NAME user
      COLOR #7FC8F8
    END
    CREATE p2 AS ICON
      POSITION 1460 160
      SIZE 100
      NAME user
      COLOR #FF8FA3
    END
    CREATE p3 AS ICON
      POSITION 460 160
      SIZE 100
      NAME user
      COLOR #9BE7A5
    END
    CREATE p4 AS ICON
      POSITION 1460 160
      SIZE 100
      NAME user
      COLOR #7FC8F8
    END
  END

  PARALLEL
    ANIMATE p1 MOVE TO 460 320
      DURATION 0.8s
      EASE bounce
    ANIMATE p2 MOVE TO 1460 320
      DURATION 0.8s
      EASE bounce
    ANIMATE p3 MOVE TO 460 580
      DURATION 0.8s
      EASE bounce
    ANIMATE p4 MOVE TO 1460 580
      DURATION 0.8s
      EASE bounce
  END

  PARALLEL
    ARROW p1 -> centerPr
      ROUTE curve
      HEAD end
      COLOR #7FC8F8
      DRAW 0.7s
    ARROW p2 -> centerPr
      ROUTE curve
      HEAD end
      COLOR #FF8FA3
      DRAW 0.7s
    ARROW p3 -> centerPr
      ROUTE curve
      HEAD end
      COLOR #9BE7A5
      DRAW 0.7s
    ARROW p4 -> centerPr
      ROUTE curve
      HEAD end
      COLOR #7FC8F8
      DRAW 0.7s
  END

  ANIMATE centerPr SCALE TO 1.3
    DURATION 0.5s
    EASE bounce

  WAIT 3.1s

  # ---- beat 2: payoff ----
  SAY "So remember: small commits, big progress, and a team that never overwrites you."
    DURATION 5.8s
    TONE punchline

  CREATE cap5 AS TEXT
    TEXT "Small commits -> big progress"
    POSITION 960 930
    SIZE 52
    COLOR #FFD966
    DRAW 0.8s
  END

  CREATE dot5 AS CIRCLE
    POSITION 1500 930
    RADIUS 20
    COLOR #FFD966
    FILL #FFD966
    DRAW 0.3s
  END

  ANIMATE dot5 SCALE TO 1.6
    DURATION 0.5s
    EASE bounce

  INK star
    POINTS 960 690, 975 735, 1022 736, 984 764, 998 810, 960 782, 922 810, 936 764, 898 736, 945 735, 960 690
    COLOR #FFD966
    WIDTH 5
    DRAW 1s
  END

  ANIMATE star ROTATE TO 12
    DURATION 0.5s
    EASE easeInOut

  ANIMATE centerPr SCALE TO 1.5
    DURATION 0.5s
    EASE bounce

  WAIT 2.5s

  # ---- beat 3: LinkedIn call to action ----
  SAY "Which GitHub feature saves you the most time?"
    DURATION 3.5s
    TONE hook

  CREATE cta AS RECTANGLE
    POSITION 960 835
    WIDTH 1100
    HEIGHT 80
    CORNERS 40
    COLOR #9BE7A5
    FILL #24332E
    TEXT "Which feature saves you the most time?"
    DRAW 0.6s
  END

  ANIMATE cta SCALE TO 1.1
    DURATION 0.5s
    EASE bounce

  WAIT 2.4s

  # ---- close scene 5 ----
END SCENE