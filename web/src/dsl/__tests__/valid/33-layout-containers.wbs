VERSION 1.0
CANVAS 1920 1080

SCENE 1 "Container layouts"
  STACK flow DIRECTION vertical GAP 24 AT 80 100
    CREATE first AS RECTANGLE
      WIDTH 120
      HEIGHT 60
      COLOR #2E86AB
      DRAW 1s
    END
    CREATE second AS TEXT
      TEXT "Second item"
      SIZE 32
      COLOR #E76F51
      DRAW 2s
    END
  END

  GRID board COLUMNS 2 GAP 16 AT 800 100
    CREATE tileA AS RECTANGLE
      WIDTH 100
      HEIGHT 50
      COLOR #2E86AB
      DRAW 0.5s
    END
    CREATE tileB AS CIRCLE
      RADIUS 30
      COLOR #E76F51
      DRAW 0.5s
    END
    CREATE tileC AS TEXT
      TEXT "Third"
      SIZE 36
      DRAW 0.5s
    END
  END

  CAMERA ZOOM
    TARGET board
    DURATION 0.5s
END SCENE