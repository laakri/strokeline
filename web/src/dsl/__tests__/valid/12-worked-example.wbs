VERSION 1.0
CANVAS 1920 1080
BACKGROUND #FAFAFA
STYLE handdrawn
FONT handwritten
STROKE 4
SCENE 1 "Intro"
  CREATE title AS TEXT
    TEXT "How does a website work?"
    POSITION 960 150
    SIZE 64
    COLOR #222222
    DRAW 1s
  END
  WAIT 0.5s
  PARALLEL
    CREATE browser AS CIRCLE
      POSITION 300 500
      RADIUS 100
      COLOR #2E86AB
      LABEL "Browser"
      DRAW 1s
    END
    CREATE server AS RECTANGLE
      POSITION 1400 500
      WIDTH 300
      HEIGHT 220
      COLOR #E76F51
      TEXT "SERVER"
      DRAW 1s
    END
  END
  WAIT 0.5s
  ARROW browser -> server
    LABEL "HTTP Request"
    DRAW 1.5s
  WAIT 1s
  CAMERA ZOOM
    TARGET server
    SCALE 1.8
    DURATION 1s
END SCENE
