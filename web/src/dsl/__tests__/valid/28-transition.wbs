VERSION 1.0
CANVAS 1920 1080

SCENE 1 "Opening"
  CREATE opening AS TEXT
    TEXT "Opening"
    POSITION 960 500
    SIZE 64
  END
  TRANSITION fade DURATION 0.6s
END SCENE

SCENE 2 "Closing"
  CREATE closing AS TEXT
    TEXT "Closing"
    POSITION 960 500
    SIZE 64
  END
  TRANSITION wipe DURATION 400ms
END SCENE