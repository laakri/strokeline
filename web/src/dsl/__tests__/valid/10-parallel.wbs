VERSION 1.0
CANVAS 1920 1080
SCENE 1
  PARALLEL
    CREATE a AS CIRCLE
      POSITION 300 500
      RADIUS 50
      DRAW 2s
    END
    CREATE b AS CIRCLE
      POSITION 700 500
      RADIUS 50
      DRAW 1s
    END
  END
  WAIT 500ms
  CREATE after AS LINE
    POSITION 100 100
    WIDTH 100
    HEIGHT 0
    DRAW 1s
  END
END SCENE
