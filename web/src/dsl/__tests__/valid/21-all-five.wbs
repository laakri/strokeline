VERSION 1.0
CANVAS 1920 1080
BACKGROUND #FAFAFA
STYLE handdrawn
FONT handwritten
STROKE 4

SCENE 1 "All five"
  CREATE source AS RECTANGLE
    POSITION 400 400
    WIDTH 240
    HEIGHT 160
    COLOR #2E86AB
    TEXT "SOURCE"
    DRAW 1s
  END

  DUPLICATE copy FROM source
    POSITION 980 400
    DRAW 1s

  CREATE divider AS LINE
    FROM 300 700
    TO 1620 720
    COLOR #888888
    DRAW 1s
  END

  CREATE star AS CIRCLE
    POSITION 660 850
    RADIUS 40
    COLOR #E76F51
    DRAW 1s
  END

  ANIMATE copy ROTATE TO 12 DURATION 1.5s EASE easeOut

  ANIMATE source HIGHLIGHT
    COLOR #FFD966
    DURATION 2s

  WAIT 1.5s

  DELETE star
    DURATION 1.5s
END SCENE