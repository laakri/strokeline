SCENE 2 "Inside a leaf"

  CREATE b_title AS TEXT
    POSITION 960 95
    SIZE 84
    TEXT "Inside a leaf"
    COLOR #F4F1E8
    DRAW 0.5s
  END

  CREATE b_title_line AS LINE
    FROM 700 165
    TO 1220 165
    COLOR #FFD966
    STROKE 8
    DRAW 0.4s
  END

  CREATE b_hin AS TEXT
    POSITION 300 195
    SIZE 40
    TEXT "INPUTS"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_hout AS TEXT
    POSITION 1620 285
    SIZE 40
    TEXT "OUTPUTS"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_leaf AS ELLIPSE
    POSITION 960 540
    WIDTH 560
    HEIGHT 400
    FILL #2E7D46
