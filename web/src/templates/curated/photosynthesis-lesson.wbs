    DRAW 0.5s
  END

  CREATE c_title_line AS LINE
    FROM 720 170
    TO 1200 170
    COLOR #FFD966
    STROKE 8
    DRAW 0.4s
  END

  CREATE c_e1 AS RECTANGLE
    POSITION 330 450
    WIDTH 280
    HEIGHT 130
    CORNERS 24
    FILL #2A4A41
    COLOR #F4A6B8
    DRAW 0.4s
  END

  CREATE c_e1t AS TEXT
    POSITION 330 450
    SIZE 64
    TEXT "6 CO2"
    COLOR #F4A6B8
    DRAW 0.3s
  END

  CREATE c_p1 AS TEXT
    POSITION 520 450
    SIZE 80
    TEXT "+"
    COLOR #F4F1E8
    DRAW 0.2s
  END

  CREATE c_e2 AS RECTANGLE
    POSITION 710 450
    WIDTH 280
    HEIGHT 130
    CORNERS 24
    FILL #2A4A41
    COLOR #8FD3F4
    DRAW 0.4s
  END

  CREATE c_e2t AS TEXT
    POSITION 710 450
    SIZE 64
    TEXT "6 H2O"
    COLOR #8FD3F4
    DRAW 0.3s
  END

  CREATE c_e3 AS RECTANGLE
    POSITION 1210 450
    WIDTH 280
    HEIGHT 130
    CORNERS 24
    FILL #2A4A41
    COLOR #FFB27A
    DRAW 0.4s
  END

  CREATE c_e3t AS TEXT
    POSITION 1210 450
    SIZE 64
    TEXT "C6H12O6"
    COLOR #FFB27A
    DRAW 0.3s
  END

  CREATE c_p2 AS TEXT
    POSITION 1400 450
    SIZE 80
    TEXT "+"
    COLOR #F4F1E8
    DRAW 0.2s
  END

  CREATE c_e4 AS RECTANGLE
    POSITION 1590 450
    WIDTH 280
    HEIGHT 130
    CORNERS 24
    FILL #2A4A41
    COLOR #A8E6A1
    DRAW 0.4s
  END

  CREATE c_e4t AS TEXT
    POSITION 1590 450
    SIZE 64
    TEXT "6 O2"
    COLOR #A8E6A1
    DRAW 0.3s
  END

  ARROW c_e2 -> c_e3
    COLOR #FFD966
    STROKE 7
    DRAW 0.6s

  CREATE c_lt AS TEXT
    POSITION 960 398
    SIZE 30
    TEXT "light energy"
    COLOR #FFD966
    DRAW 0.3s
  END

  CREATE c_lb AS TEXT
    POSITION 960 504
    SIZE 30
    TEXT "chlorophyll"
    COLOR #FFD966
    DRAW 0.3s
  END

  CREATE c_k1 AS TEXT
    POSITION 330 570
    SIZE 34
    TEXT "carbon dioxide"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE c_k2 AS TEXT
    POSITION 710 570
    SIZE 34
    TEXT "water"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE c_k3 AS TEXT
    POSITION 1210 570
    SIZE 34
    TEXT "glucose"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE c_k4 AS TEXT
    POSITION 1590 570
    SIZE 34
    TEXT "oxygen"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  SAY "Chemists balance the equation so atoms are never created or destroyed, only rearranged into sugar and oxygen."
    DURATION 5s
    TONE explain
    DETAIL "Connects the equation to conservation of atoms."

  CREATE c_quiz AS TEXT
    POSITION 960 660
    SIZE 52
