    DRAW 0.3s
  END

  CREATE b_leaf_d AS TEXT
    POSITION 960 615
    SIZE 34
    MAXWIDTH 460
    ALIGN center
    TEXT "chlorophyll captures the light"
    COLOR #F4F1E8
    DRAW 0.4s
  END

  CREATE b_n1 AS RECTANGLE
    POSITION 300 300
    WIDTH 420
    HEIGHT 120
    CORNERS 24
    FILL #2A4A41
    COLOR #FFD966
    DRAW 0.4s
  END

  CREATE b_n1t AS TEXT
    POSITION 300 270
    SIZE 40
    TEXT "Sunlight"
    COLOR #FFD966
    DRAW 0.3s
  END

  CREATE b_n1d AS TEXT
    POSITION 300 326
    SIZE 26
    TEXT "the energy source"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_n2 AS RECTANGLE
    POSITION 300 540
    WIDTH 420
    HEIGHT 120
    CORNERS 24
    FILL #2A4A41
    COLOR #8FD3F4
    DRAW 0.4s
  END

  CREATE b_n2t AS TEXT
    POSITION 300 510
    SIZE 40
    TEXT "Water (H2O)"
    COLOR #8FD3F4
    DRAW 0.3s
  END

  CREATE b_n2d AS TEXT
    POSITION 300 566
    SIZE 26
    TEXT "taken up by the roots"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_n3 AS RECTANGLE
    POSITION 300 780
    WIDTH 420
    HEIGHT 120
    CORNERS 24
    FILL #2A4A41
    COLOR #F4A6B8
    DRAW 0.4s
  END

  CREATE b_n3t AS TEXT
    POSITION 300 750
    SIZE 36
    TEXT "Carbon dioxide (CO2)"
    COLOR #F4A6B8
    DRAW 0.3s
  END

  CREATE b_n3d AS TEXT
    POSITION 300 806
    SIZE 26
    TEXT "enters through tiny pores"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_o1 AS RECTANGLE
    POSITION 1620 400
    WIDTH 420
    HEIGHT 120
    CORNERS 24
    FILL #2A4A41
    COLOR #FFB27A
    DRAW 0.4s
  END

  CREATE b_o1t AS TEXT
    POSITION 1620 370
    SIZE 40
    TEXT "Glucose"
    COLOR #FFB27A
    DRAW 0.3s
  END

  CREATE b_o1d AS TEXT
    POSITION 1620 426
    SIZE 26
    TEXT "sugar the plant stores"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  CREATE b_o2 AS RECTANGLE
    POSITION 1620 680
    WIDTH 420
    HEIGHT 120
    CORNERS 24
    FILL #2A4A41
    COLOR #A8E6A1
    DRAW 0.4s
  END

  CREATE b_o2t AS TEXT
    POSITION 1620 650
    SIZE 40
    TEXT "Oxygen (O2)"
    COLOR #A8E6A1
    DRAW 0.3s
  END

  CREATE b_o2d AS TEXT
    POSITION 1620 706
    SIZE 26
    TEXT "released into the air"
    COLOR #D9D5C7
    DRAW 0.3s
  END

  ARROW b_n1 -> b_leaf
    COLOR #FFD966
    STROKE 6
    DRAW 0.5s

  ARROW b_n2 -> b_leaf
    COLOR #8FD3F4
    STROKE 6
    DRAW 0.5s

  ARROW b_n3 -> b_leaf
    COLOR #F4A6B8
    STROKE 6
    DRAW 0.5s

  ARROW b_leaf -> b_o1
    COLOR #FFB27A
    STROKE 6
    DRAW 0.5s

  ARROW b_leaf -> b_o2
    COLOR #A8E6A1
    STROKE 6
    DRAW 0.5s

  SAY "Think of the leaf as a tiny factory: three things arrive, two things leave, and nothing is wasted along the way."
    DURATION 5s
    TONE explain
    DETAIL "Factory analogy that connects inputs to outputs."

  CREATE b_foot AS TEXT
    POSITION 967.3 923.5
    SIZE 44
    MAXWIDTH 1700
    ALIGN center
    TEXT "Light, water and carbon dioxide make glucose and oxygen"
    COLOR #FFD966
    DRAW 0.6s
  END

  TRANSITION fade DURATION 0.8s
END SCENE

SCENE 3 "The equation and quick check"

  CREATE c_title AS TEXT
    POSITION 960 100
