  CREATE nb AS CIRCLE
    POSITION 260 650
    RADIUS 100
    FILL #0F3677
    COLOR #FFC857
    STROKE 5
    DRAW 0.3s
  END
  CREATE nb_i AS ICON
    POSITION 260 650
    SIZE 110
    NAME battery
    COLOR #FFC857
    STROKE 4
    DRAW 0.3s
  END
  CREATE nl AS CIRCLE
    POSITION 1660 650
    RADIUS 100
    FILL #0F3677
    COLOR #7CF2C0
    STROKE 5
    DRAW 0.3s
