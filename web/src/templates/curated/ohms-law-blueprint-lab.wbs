  CREATE nl_i AS ICON
    POSITION 1660 650
    SIZE 110
    NAME lightbulb
    COLOR #7CF2C0
    STROKE 4
    DRAW 0.3s
  END
  ARROW nb -> plate
    ROUTE straight
    HEAD end
    LINESTYLE dashed
    COLOR #6FE0FF
    STROKE 5
    DRAW 0.4s
  ARROW plate -> nl
    ROUTE straight
    HEAD end
    LINESTYLE dashed
    COLOR #6FE0FF
    STROKE 5
    DRAW 0.4s
  CREATE d1 AS CIRCLE
    POSITION 570 860
    RADIUS 8
    FILL #6FE0FF
    COLOR #6FE0FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE d2 AS CIRCLE
    POSITION 1350 860
    RADIUS 8
    FILL #6FE0FF
    COLOR #6FE0FF
    STROKE 2
    DRAW 0.2s
  END
  ARROW d1 -> d2
    ROUTE straight
    HEAD both
    LINESTYLE dashed
    COLOR #4C8BD6
    STROKE 3
    DRAW 0.5s
  WAIT 1s
  TRANSITION wipe DURATION 0.5s
END SCENE

