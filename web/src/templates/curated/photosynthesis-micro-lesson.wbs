// Strokeline Education Style 10: Vertical Micro-Lesson (1080x1920)
// Purpose: Copy-ready template for TikTok, Reels and YouTube Shorts. One fact per scene.
// Demo topic: Photosynthesis (same topic as the Chalkboard and Mind Map styles).
// Look: near-black background, lime accent, pink hook underline, progress bar on top,
//   hook line at the top, one big visual in the middle, takeaway card below, brand pill at the foot.
// Scenes: 1 hook, 2 fact 1, 3 fact 2, 4 remember + call to action.
//
// HOW TO REUSE
//  1. Change the hook text (big white line), the badge, and the takeaway card text in each scene.
//  2. Visual zone is y=620..1040. Swap the icons (NAME ...) and circle colors for your topic.
//  3. SUBTITLES is on: the band y=1300..1580 is kept empty on purpose. Do not place content there.
//  4. Keep hooks to about 20 characters so they stay on 1-2 lines at SIZE 110.
//  5. Keep each scene under 12 text objects (validator limit W_TOO_CROWDED).
//  6. Safe icons: leaf, zap, droplet, wind, apple, star, lightbulb, flask-conical, eraser.
//
// Validator status: run with the Strokeline app validator before publishing.
VERSION 1.0
CANVAS 1080 1920
BACKGROUND #101820
STYLE clean
FONT neat
STROKE 4
SUBTITLES on

SCENE 1 "Hook"
  SAY "Here is the weirdest part of a leaf's day job, in under half a minute."
    DURATION 4s
    TONE hook
  CREATE pg1 AS RECTANGLE
    POSITION 270 100
    WIDTH 150
    HEIGHT 14
    CORNERS 7
    FILL #B6FF3B
    COLOR #B6FF3B
    STROKE 2
    DRAW 0.1s
  END
  CREATE pg2 AS RECTANGLE
    POSITION 450 100
    WIDTH 150
    HEIGHT 14
    CORNERS 7
    FILL #2B3A4F
    COLOR #2B3A4F
    STROKE 2
    DRAW 0.1s
  END
  CREATE pg3 AS RECTANGLE
    POSITION 630 100
    WIDTH 150
    HEIGHT 14
    CORNERS 7
    FILL #2B3A4F
    COLOR #2B3A4F
    STROKE 2
    DRAW 0.1s
  END
  CREATE pg4 AS RECTANGLE
    POSITION 810 100
    WIDTH 150
    HEIGHT 14
    CORNERS 7
    FILL #2B3A4F
    COLOR #2B3A4F
    STROKE 2
    DRAW 0.1s
  END
  CREATE badge AS RECTANGLE
    POSITION 540 230
    WIDTH 520
    HEIGHT 80
    CORNERS 40
    FILL #1B2A3D
    COLOR #B6FF3B
    STROKE 4
    TEXT "60-SECOND LESSON"
    SIZE 40
    DRAW 0.3s
  END
  CREATE hook AS TEXT
    POSITION 540 460
    SIZE 110
    TEXT "Plants eat air"
    COLOR #FFFFFF
    MAXWIDTH 940
    ALIGN center
    DRAW 0.7s
  END
  INK UNDERLINE hook
    COLOR #FF4D8D
    WIDTH 12
    DRAW 0.5s
  END
  CREATE hub AS CIRCLE
    POSITION 540 820
    RADIUS 200
    FILL #16402A
    COLOR #B6FF3B
    STROKE 6
    SHADOW 18
    DRAW 0.7s
  END
  CREATE hub_i AS ICON
    POSITION 540 820
    SIZE 260
    NAME leaf
    COLOR #B6FF3B
    STROKE 5
    DRAW 0.5s
  END
  CREATE o1 AS CIRCLE
    POSITION 190 700
    RADIUS 80
    FILL #1B2A3D
    COLOR #5CC8FF
    STROKE 4
    SHADOW 18
    DRAW 0.3s
  END
  CREATE o1_i AS ICON
    POSITION 190 700
    SIZE 100
    NAME wind
    COLOR #5CC8FF
    STROKE 5
    DRAW 0.3s
  END
  CREATE o2 AS CIRCLE
    POSITION 890 940
    RADIUS 80
    FILL #1B2A3D
    COLOR #5CC8FF
    STROKE 4
    SHADOW 18
    DRAW 0.3s
  END
  CREATE o2_i AS ICON
    POSITION 890 940
    SIZE 100
    NAME droplet
    COLOR #5CC8FF
    STROKE 5
    DRAW 0.3s
  END
  CREATE take AS RECTANGLE
    POSITION 540 1160
    WIDTH 900
    HEIGHT 200
    CORNERS 32
    FILL #1B2A3D
    COLOR #B6FF3B
    STROKE 5
    SHADOW 16
    TEXT "Mostly air and sunlight."
    SIZE 50
    DRAW 0.6s
  END
  CREATE brand AS RECTANGLE
    POSITION 540 1790
    WIDTH 520
    HEIGHT 90
    CORNERS 45
    FILL #B6FF3B
    COLOR #101820
    STROKE 3
    TEXT "STROKELINE MICRO-LESSON"
    SIZE 32
    DRAW 0.4s
  END
  WAIT 0.8s
  TRANSITION slide DURATION 0.4s
END SCENE

SCENE 2 "Fact one"
  SAY "Pigment in the leaf grabs sunshine like a tiny solar panel."
    DURATION 4s
    TONE explain
  CREATE pg1 AS RECTANGLE
    POSITION 270 100
    WIDTH 150
    HEIGHT 14
    CORNERS 7
    FILL #2B3A4F
    COLOR #2B3A4F
    STROKE 2
