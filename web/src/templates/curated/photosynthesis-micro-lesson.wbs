    HEIGHT 14
    CORNERS 7
    FILL #2B3A4F
    COLOR #2B3A4F
    STROKE 2
    DRAW 0.1s
  END
  CREATE badge AS RECTANGLE
    POSITION 540 230
    WIDTH 520
    HEIGHT 80
    CORNERS 40
    FILL #1B2A3D
    COLOR #B6FF3B
    STROKE 4
    TEXT "FACT 1"
    SIZE 40
    DRAW 0.3s
  END
  CREATE hook AS TEXT
    POSITION 540 460
    SIZE 110
    TEXT "Light is the fuel"
    COLOR #FFFFFF
    MAXWIDTH 940
    ALIGN center
    DRAW 0.7s
  END
  INK UNDERLINE hook
    COLOR #FF4D8D
    WIDTH 12
    DRAW 0.5s
  END
  CREATE sun AS CIRCLE
    POSITION 290 800
    RADIUS 140
    FILL #1B2A3D
    COLOR #FFC857
    STROKE 6
    SHADOW 18
    DRAW 0.5s
  END
  CREATE sun_i AS ICON
    POSITION 290 800
    SIZE 170
    NAME zap
    COLOR #FFC857
    STROKE 5
    DRAW 0.4s
  END
  CREATE lf AS CIRCLE
    POSITION 790 800
    RADIUS 140
    FILL #16402A
    COLOR #B6FF3B
    STROKE 6
    SHADOW 18
    DRAW 0.5s
  END
  CREATE lf_i AS ICON
    POSITION 790 800
    SIZE 170
    NAME leaf
    COLOR #B6FF3B
    STROKE 5
    DRAW 0.4s
  END
  ARROW sun -> lf
    ROUTE straight
    HEAD end
    COLOR #FF4D8D
    STROKE 8
    DRAW 0.4s
  CREATE take AS RECTANGLE
    POSITION 540 1160
    WIDTH 900
    HEIGHT 200
    CORNERS 32
    FILL #1B2A3D
    COLOR #B6FF3B
    STROKE 5
    SHADOW 16
    TEXT "Chlorophyll catches light energy."
    SIZE 50
    DRAW 0.6s
  END
  CREATE brand AS RECTANGLE
    POSITION 540 1790
    WIDTH 520
    HEIGHT 90
    CORNERS 45
    FILL #B6FF3B
    COLOR #101820
    STROKE 3
    TEXT "STROKELINE MICRO-LESSON"
    SIZE 32
    DRAW 0.4s
  END
  WAIT 0.8s
  TRANSITION slide DURATION 0.4s
END SCENE

