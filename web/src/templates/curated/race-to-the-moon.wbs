// ============================================================
// STYLE 7: Timeline Scroll  (template + demo topic)
// Topic: Race to the Moon, 1957 to 1969 (six milestones)
// Look: warm parchment page between two scroll rollers, a long
//   horizontal axis, dated dots, little drawn icons above each date,
//   short captions below. A marker rides the axis to each milestone.
// A mini-map (six dots) at the bottom shows where you are in the run.
// Last scene re-draws the axis to scale so gaps and clusters show.
// Palette: ink brown #4A2E1A, rust #9C3D1B, muted #6B4A2B.
// Reuse: keep axis y=520, icon y=300, date y=410, caption y=680.
// Max 3 milestones per scene (keeps text count under 12).
// ============================================================
VERSION 1.0
CANVAS 1920 1080
BACKGROUND #F2E2BE
BOARD paper
STYLE handdrawn
FONT handwritten
STROKE 4
SUBTITLES off

SCENE 1 "Title scroll"
  CREATE rollL1 AS RECTANGLE
    POSITION 70 540
    WIDTH 56
    HEIGHT 940
    FILL #D9B97A
    COLOR #4A2E1A
    STROKE 4
    CORNERS 28
    DRAW 0.6s
  END
  CREATE rollR1 AS RECTANGLE
    POSITION 1850 540
    WIDTH 56
    HEIGHT 940
    FILL #D9B97A
    COLOR #4A2E1A
    STROKE 4
    CORNERS 28
    DRAW 0.6s
  END
  CREATE earth AS CIRCLE
    POSITION 500 740
    RADIUS 70
    FILL #5B9AA0
    COLOR #4A2E1A
    STROKE 5
    DRAW 0.6s
  END
  CREATE land1 AS ELLIPSE
    POSITION 480 720
    WIDTH 60
    HEIGHT 36
    FILL #7FAE6B
    COLOR #7FAE6B
    STROKE 1
    DRAW 0.3s
  END
  CREATE land2 AS ELLIPSE
    POSITION 525 765
    WIDTH 44
    HEIGHT 28
    FILL #7FAE6B
    COLOR #7FAE6B
    STROKE 1
    DRAW 0.3s
  END
  CREATE moon AS CIRCLE
    POSITION 1420 700
    RADIUS 100
    FILL #E8DFC8
    COLOR #4A2E1A
    STROKE 5
    DRAW 0.7s
  END
  CREATE cr1 AS CIRCLE
    POSITION 1385 665
    RADIUS 22
    FILL #CFC3A4
    COLOR #CFC3A4
    STROKE 1
    DRAW 0.2s
  END
  CREATE cr2 AS CIRCLE
    POSITION 1450 735
    RADIUS 28
    FILL #CFC3A4
    COLOR #CFC3A4
    STROKE 1
    DRAW 0.2s
  END
  CREATE cr3 AS CIRCLE
    POSITION 1455 655
    RADIUS 14
    FILL #CFC3A4
    COLOR #CFC3A4
    STROKE 1
    DRAW 0.2s
  END
  CREATE path AS LINE
    FROM 600 735
    TO 1310 705
    COLOR #6B4A2B
    STROKE 4
    DRAW 0.8s
  END
  CREATE title1 AS TEXT
    POSITION 960 290
    SIZE 130
    COLOR #4A2E1A
    TEXT "Race to the Moon"
    DRAW 1s
  END
  CREATE sub1 AS TEXT
    POSITION 960 430
    SIZE 64
    COLOR #9C3D1B
    TEXT "A timeline, 1957 to 1969"
    DRAW 0.8s
  END
  CREATE earthLbl AS TEXT
    POSITION 500 850
    SIZE 36
    COLOR #6B4A2B
    TEXT "Earth"
    DRAW 0.4s
  END
  CREATE moonLbl AS TEXT
    POSITION 1420 850
    SIZE 36
    COLOR #6B4A2B
    TEXT "Moon"
    DRAW 0.4s
  END
  CREATE capsule AS DIAMOND
    POSITION 620 732
    WIDTH 56
    HEIGHT 34
    FILL #9C3D1B
    COLOR #4A2E1A
    STROKE 4
    DRAW 0.4s
  END
  ANIMATE capsule MOVE TO 1290 708
    DURATION 2s
    EASE easeInOut
  SAY "Twelve years, six turning points: let's unroll the scroll."
    DURATION 3.6s
    TONE hook
    WHO "Narrator"
    LANG en
    DETAIL "Frames the lesson as a journey from Earth to the Moon."
  TRANSITION slide DURATION 0.6s
END SCENE

