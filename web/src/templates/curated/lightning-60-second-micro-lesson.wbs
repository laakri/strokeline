  CREATE tag1 AS TEXT
    POSITION 540 215
    SIZE 34
    COLOR #5CC8FF
    TEXT "LIGHTNING IN 60 SECONDS"
    DRAW 0.4s
  END
  CREATE hook1 AS TEXT
    POSITION 540 335
    SIZE 68
    MAXWIDTH 880
    ALIGN center
    COLOR #FFFFFF
    TEXT "Lightning is hotter than the Sun's surface."
    DRAW 0.8s
  END
  CREATE base1 AS LINE
    FROM 140 1060
    TO 940 1060
    COLOR #FFFFFF
    STROKE 4
    DRAW 0.4s
  END
  CREATE barSun AS RECTANGLE
    POSITION 300 1008
    WIDTH 260
    HEIGHT 104
    FILL #FFA726
    COLOR #FFFFFF
    STROKE 4
    CORNERS 10
    DRAW 0.7s
  END
  CREATE barBolt AS RECTANGLE
    POSITION 700 790
    WIDTH 260
    HEIGHT 540
    FILL #FFD93D
    COLOR #FFFFFF
    STROKE 4
    CORNERS 10
    DRAW 1.2s
  END
  CREATE sparkA AS LINE
    FROM 560 520
    TO 520 480
    COLOR #FFD93D
    STROKE 6
    DRAW 0.15s
  END
  CREATE sparkB AS LINE
    FROM 555 570
    TO 505 570
    COLOR #FFD93D
    STROKE 6
    DRAW 0.15s
  END
  CREATE valSun AS TEXT
    POSITION 300 912
    SIZE 46
    COLOR #FFFFFF
    TEXT "5,800 K"
    DRAW 0.5s
  END
  CREATE valBolt AS TEXT
    POSITION 700 475
    SIZE 52
    COLOR #FFD93D
    TEXT "30,000 K"
    DRAW 0.5s
  END
  ANIMATE valBolt SCALE TO 1.15
    DURATION 0.2s
    EASE bounce
  ANIMATE valBolt SCALE TO 1
    DURATION 0.2s
  CREATE catSun AS TEXT
    POSITION 300 1105
    SIZE 36
    COLOR #FFFFFF
    TEXT "Sun's surface"
    DRAW 0.4s
  END
  CREATE catBolt AS TEXT
    POSITION 700 1105
    SIZE 36
    COLOR #FFFFFF
    TEXT "Lightning"
    DRAW 0.4s
  END
  CREATE take1 AS TEXT
    POSITION 540 1215
    SIZE 64
    MAXWIDTH 880
    ALIGN center
    COLOR #FFD93D
    TEXT "About 5x hotter"
    DRAW 0.8s
  END
  SAY "The air in its path superheats so fast that it explodes outward."
    DURATION 3.8s
    TONE hook
    WHO "Narrator"
    LANG en
    DETAIL "Hints at where thunder comes from."
  TRANSITION slide DURATION 0.4s
END SCENE

