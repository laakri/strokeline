// ============================================================
// STYLE 10: Vertical Micro-Lesson (1080x1920)  (template + demo topic)
// Topic: Lightning in 60 seconds - five facts + a recap card
// Phone-first rules built in:
//   top slot    y=215 series tag, y=335 hook line (2 lines max)
//   visual zone y=450..1100  (one fact, one picture, one number)
//   takeaway    y=1215, big, 2 lines max
//   subtitle band y=1300..1580 is LEFT EMPTY (SUBTITLES on)
//   progress dots y=1665 (shapes only), text stays above y=1720
//   keep text x between 100 and 980 (right-side buttons)
// One fact per scene, ~8-10 s each. Dark stage, yellow = the number.
// Reuse: swap hook / visual / takeaway, keep the slots.
// ============================================================
VERSION 1.0
CANVAS 1080 1920
BACKGROUND #0B1030
BOARD plain
STYLE clean
FONT neat
STROKE 4
SUBTITLES on

SCENE 1 "Hotter than the Sun"
  CREATE prog1_0 AS CIRCLE
    POSITION 365 1665
    RADIUS 12
    FILL #FFD93D
    COLOR #FFD93D
    STROKE 3
    DRAW 0.1s
  END
  CREATE prog1_1 AS CIRCLE
    POSITION 435 1665
    RADIUS 12
    COLOR #8A93C8
    STROKE 3
    DRAW 0.1s
  END
  CREATE prog1_2 AS CIRCLE
