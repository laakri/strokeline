  CREATE partName1 AS TEXT
    POSITION 330 650
    SIZE 38
    MAXWIDTH 340
    ALIGN center
    COLOR #FFFFFF
    TEXT "9 V battery"
    DRAW 0.5s
  END
  CREATE partName2 AS TEXT
    POSITION 750 650
    SIZE 38
    MAXWIDTH 340
    ALIGN center
    COLOR #FFFFFF
    TEXT "390 ohm resistor"
    DRAW 0.5s
  END
  CREATE partName3 AS TEXT
    POSITION 1170 650
