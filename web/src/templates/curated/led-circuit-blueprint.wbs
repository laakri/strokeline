// ============================================================
// STYLE 4: Blueprint Lab  (template + demo topic)
// Topic: Why every LED needs a resistor (9 V supply, 2 V LED, 20 mA)
// Look: deep-blue drafting board, thin cyan/white lines, yellow callouts,
//   dimension lines with end ticks, title block, registration marks,
//   and an APPROVED stamp at the end.
// Palette by meaning:
//   white #FFFFFF = main text    cyan #7FE3FF = parts and linework
//   yellow #FFD86B = callouts    mint #7CF2A8 = pass / approved
//   orange #FF9E6B = danger
// Reuse: keep the header + title block (scene 1), swap parts and numbers.
// ============================================================
VERSION 1.0
CANVAS 1920 1080
BACKGROUND #0B2A5B
BOARD blueprint
STYLE clean
FONT neat
STROKE 3
SUBTITLES off

SCENE 1 "Title sheet"
  CREATE sheetFrame AS RECTANGLE
    POSITION 960 540
    WIDTH 1700
    HEIGHT 900
    COLOR #7FE3FF
    STROKE 3
    CORNERS 2
    DRAW 1.2s
  END
  CREATE regH1 AS LINE
    FROM 165 170
    TO 215 170
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE regV1 AS LINE
    FROM 190 145
    TO 190 195
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE regH2 AS LINE
    FROM 1705 170
    TO 1755 170
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE regV2 AS LINE
    FROM 1730 145
    TO 1730 195
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE regH3 AS LINE
    FROM 165 910
    TO 215 910
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE regV3 AS LINE
    FROM 190 885
    TO 190 935
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE labTag AS TEXT
    POSITION 960 270
    SIZE 40
    COLOR #7FE3FF
    TEXT "BLUEPRINT LAB"
    DRAW 0.6s
  END
  CREATE sheetTitle AS TEXT
    POSITION 960 400
    SIZE 120
    COLOR #FFFFFF
    TEXT "LED CIRCUIT"
    DRAW 0.9s
  END
  CREATE titleDimL AS LINE
    FROM 560 490
    TO 1360 490
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.5s
  END
  CREATE titleDimA AS LINE
    FROM 560 470
    TO 560 510
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE titleDimB AS LINE
    FROM 1360 470
    TO 1360 510
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.2s
  END
  CREATE sheetSub AS TEXT
    POSITION 960 580
    SIZE 56
    COLOR #BFD9FF
    TEXT "Why every LED needs a resistor"
    DRAW 0.8s
  END
  CREATE titleBlock AS RECTANGLE
    POSITION 1450 860
    WIDTH 520
    HEIGHT 150
    COLOR #7FE3FF
    STROKE 3
    CORNERS 2
    DRAW 0.6s
  END
  CREATE blockDivider AS LINE
    FROM 1190 860
    TO 1710 860
    COLOR #7FE3FF
    STROKE 3
    DRAW 0.3s
  END
  CREATE blockSheet AS TEXT
    POSITION 1450 825
    SIZE 30
    COLOR #BFD9FF
    TEXT "SHEET 01 / 06"
    DRAW 0.4s
  END
  CREATE blockScale AS TEXT
    POSITION 1450 895
    SIZE 30
    COLOR #BFD9FF
    TEXT "SCALE 1:1   REV A"
    DRAW 0.4s
  END
  SAY "Every gadget starts as a drawing, so let's engineer a tiny lamp."
    DURATION 3.4s
    TONE hook
    WHO "Narrator"
    LANG en
    DETAIL "Frames the lesson as an engineering job."
  TRANSITION wipe DURATION 0.6s
END SCENE

