  CREATE leader3 AS LINE
    FROM 1170 340
    TO 1170 415
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.3s
  END
  CREATE callout3 AS CIRCLE
    POSITION 1170 300
    RADIUS 40
    FILL #0B2A5B
    COLOR #FFD86B
    STROKE 3
    DRAW 0.4s
  END
  CREATE callNum3 AS TEXT
    POSITION 1170 300
    SIZE 44
    COLOR #FFD86B
    TEXT "3"
    DRAW 0.3s
  END
  CREATE leader4 AS LINE
    FROM 1590 340
    TO 1590 415
    COLOR #BFD9FF
    STROKE 2
    DRAW 0.3s
