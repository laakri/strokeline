      DRAW 0.3s
    END
    CREATE s1_def AS RECTANGLE
      POSITION 1360 340
      WIDTH 960
      HEIGHT 300
      CORNERS 26
      FILL #FFD60A
      COLOR #0A0A0A
      STROKE 4
      DRAW 0.35s
    END
    CREATE s1_deflabel AS TEXT
      POSITION 1360 235
      SIZE 28
      COLOR #0A0A0A
      TEXT "WHAT IS GIT?"
      DRAW 0.3s
    END
    CREATE s1_deftext AS TEXT
      POSITION 1360 360
      SIZE 38
      MAXWIDTH 860
      COLOR #0A0A0A
      TEXT "Git is a time machine for your code. It saves snapshots so you can undo mistakes and work together."
      DRAW 0.3s
    END
    CREATE s1_card1 AS RECTANGLE
      POSITION 565 770
      WIDTH 490
      HEIGHT 340
      CORNERS 26
      FILL #1F4FFF
      COLOR #0A0A0A
      STROKE 4
      DRAW 0.35s
    END
    CREATE s1_n1 AS TEXT
      POSITION 565 675
      SIZE 90
      COLOR #FFFFFF
      TEXT "1"
      DRAW 0.3s
    END
    CREATE s1_h1 AS TEXT
      POSITION 565 765
      SIZE 46
      COLOR #FFFFFF
      TEXT "Snapshot"
      DRAW 0.3s
    END
    CREATE s1_c1 AS TEXT
      POSITION 565 840
      SIZE 30
      MAXWIDTH 430
      COLOR #FFFFFF
