    CREATE s1_h2 AS TEXT
      POSITION 1080 765
      SIZE 46
      COLOR #0A0A0A
      TEXT "Branch"
      DRAW 0.3s
    END
    CREATE s1_c2 AS TEXT
      POSITION 1080 840
      SIZE 30
      MAXWIDTH 430
      COLOR #0A0A0A
      TEXT "Try ideas without breaking the main code"
      DRAW 0.3s
    END
    CREATE s1_card3 AS RECTANGLE
      POSITION 1595 770
      WIDTH 490
      HEIGHT 340
      CORNERS 26
      FILL #FF3B30
      COLOR #0A0A0A
      STROKE 4
      DRAW 0.35s
    END
    CREATE s1_n3 AS TEXT
