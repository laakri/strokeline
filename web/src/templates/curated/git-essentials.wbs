    CREATE s1_c3 AS TEXT
      POSITION 1595 840
      SIZE 30
      MAXWIDTH 430
      COLOR #0A0A0A
      TEXT "Combine work from many people"
      DRAW 0.3s
    END
  END
  SAY "Every developer relies on this safety net."
    DURATION 2.6s
    TONE hook
    WHO "Narrator"
    LANG en
    DETAIL "Sets the stakes: version control is a daily professional tool."
  SAY "Three ideas explain most of it."
    DURATION 2.2s
    TONE explain
    WHO "Narrator"
    LANG en
    DETAIL "Previews the structure before the details start."
  TRANSITION fade DURATION 0.4s
END SCENE

