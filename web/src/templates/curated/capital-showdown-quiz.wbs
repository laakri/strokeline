    FILL #1B1340
    COLOR #1B1340
    STROKE 3
    CORNERS 30
    OPACITY 0
    DRAW 0.1s
  END
  CREATE question AS TEXT
    POSITION 960 330
    SIZE 80
    MAXWIDTH 1300
    ALIGN center
    COLOR #1B1340
    TEXT "What is the capital of Australia?"
    DRAW 0.9s
  END
  CREATE scoreLabel AS TEXT
    POSITION 230 900
    SIZE 36
    COLOR #E9E2FF
    TEXT "SCORE"
    DRAW 0.3s
  END
  CREATE star0 AS CIRCLE
    POSITION 360 900
    RADIUS 24
    COLOR #FFE066
    STROKE 3
    DRAW 0.15s
  END
  CREATE star1 AS CIRCLE
