    COLOR #FFE066
    STROKE 3
    DRAW 0.15s
  END
  CREATE star3 AS CIRCLE
    POSITION 552 900
    RADIUS 24
    COLOR #FFE066
    STROKE 3
    DRAW 0.15s
  END
  CREATE star4 AS CIRCLE
    POSITION 616 900
    RADIUS 24
    COLOR #FFE066
    STROKE 3
    DRAW 0.15s
  END
  CREATE seg0 AS RECTANGLE
    POSITION 336 1010
    WIDTH 300
    HEIGHT 18
    COLOR #E9E2FF
    STROKE 2
    CORNERS 9
    DRAW 0.15s
  END
  CREATE seg1 AS RECTANGLE
    POSITION 648 1010
    WIDTH 300
    HEIGHT 18
    COLOR #E9E2FF
    STROKE 2
    CORNERS 9
    DRAW 0.15s
  END
  CREATE seg2 AS RECTANGLE
    POSITION 960 1010
    WIDTH 300
    HEIGHT 18
    COLOR #E9E2FF
    STROKE 2
    CORNERS 9
    DRAW 0.15s
  END
  CREATE seg3 AS RECTANGLE
    POSITION 1272 1010
    WIDTH 300
    HEIGHT 18
    COLOR #E9E2FF
    STROKE 2
    CORNERS 9
    DRAW 0.15s
  END
  CREATE seg4 AS RECTANGLE
    POSITION 1584 1010
    WIDTH 300
    HEIGHT 18
    COLOR #E9E2FF
    STROKE 2
    CORNERS 9
    DRAW 0.15s
  END
  SAY "Most people shout the biggest city."
    DURATION 2.6s
    TONE explain
    WHO "Host"
    LANG en
    DETAIL "Plants a tempting wrong answer before the countdown."
  CREATE cd3 AS TEXT
    POSITION 960 485
    SIZE 100
    COLOR #1B1340
    TEXT "3"
    DRAW 0.2s
  END
  WAIT 0.6s
  DELETE cd3
  CREATE cd2 AS TEXT
    POSITION 960 485
    SIZE 100
    COLOR #1B1340
    TEXT "2"
    DRAW 0.2s
  END
  WAIT 0.6s
  DELETE cd2
  CREATE cd1 AS TEXT
    POSITION 960 485
    SIZE 100
    COLOR #1B1340
    TEXT "1"
    DRAW 0.2s
  END
  WAIT 0.6s
  DELETE cd1
  ANIMATE answerPanel OPACITY TO 1
    DURATION 0.2s
  CREATE answer AS TEXT
    POSITION 960 620
    SIZE 96
    COLOR #FFE066
    TEXT "Canberra"
    DRAW 0.5s
  END
  ANIMATE answer SCALE TO 1.2
    DURATION 0.2s
    EASE bounce
  ANIMATE answer SCALE TO 1
    DURATION 0.2s
  CREATE tickRing AS CIRCLE
    POSITION 330 620
    RADIUS 48
    FILL #43D17A
    COLOR #43D17A
    STROKE 2
    DRAW 0.3s
  END
  CREATE tickA AS LINE
    FROM 308 622
    TO 324 640
    COLOR #FFFFFF
    STROKE 8
    DRAW 0.15s
  END
  CREATE tickB AS LINE
    FROM 324 640
    TO 355 600
    COLOR #FFFFFF
    STROKE 8
    DRAW 0.15s
  END
  CREATE starWin AS CIRCLE
    POSITION 360 900
    RADIUS 24
    FILL #FFE066
    COLOR #FFE066
    STROKE 3
    DRAW 0.2s
  END
  CREATE segWin AS RECTANGLE
    POSITION 336 1010
    WIDTH 300
    HEIGHT 18
    FILL #FF7AA8
    COLOR #FF7AA8
    STROKE 2
    CORNERS 9
    DRAW 0.3s
  END
  CREATE fact AS TEXT
    POSITION 960 785
    SIZE 40
    MAXWIDTH 1500
    ALIGN center
    COLOR #E9E2FF
    TEXT "Not Sydney! Canberra was built as a peace deal between rivals."
    DRAW 0.8s
  END
  SAY "Big and famous does not mean official."
    DURATION 2.8s
    TONE punchline
    WHO "Host"
    LANG en
    DETAIL "Adds the lesson behind the answer."
  TRANSITION slide DURATION 0.5s
END SCENE

