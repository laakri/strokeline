SCENE 2 "Question 1"
  CREATE showName AS TEXT
    POSITION 420 130
    SIZE 40
    COLOR #FFE066
    TEXT "CAPITAL SHOWDOWN"
    DRAW 0.4s
  END
  CREATE qCount AS TEXT
    POSITION 1500 130
    SIZE 40
    COLOR #E9E2FF
    TEXT "Question 1 of 5"
    DRAW 0.4s
